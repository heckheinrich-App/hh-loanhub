# ==============================================================================
# HH LOANHUB - Environment Configuration Template
# Copy this file to .env and customize for your local setup.
# NOTE: .env contains sensitive credentials and is never pushed to GitHub.
# ==============================================================================

# Public Cloudflare Tunnel URL pointing to your local core engine (used by Render Gateway)
# Example: https://hh-loanhub-core.trycloudflare.com or https://api.yourdomain.com
CLOUDFLARE_TUNNEL_URL=https://ruth-mason-threshold-office.trycloudflare.com

# Render Public Gateway URL (used by local engine for automatic free-tier keep-alive pings)
RENDER_GATEWAY_URL=https://hh-loanhub-gateway.onrender.com

# Local Core FastAPI Engine Server Port
PORT=8000

# Environment mode: development | staging | production
ENV=development

# Google Drive Desktop Sync folder path for automated zero-loss database backups
# Update this to match your local Google Drive mirror folder path:
GDRIVE_BACKUP_PATH=C:\Users\Public\GoogleDrive\HH_LOANHUB_Backups
