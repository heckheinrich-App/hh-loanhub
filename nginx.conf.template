server {
    listen ${PORT};
    server_name _;

    # Compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    # Static Frontend Assets
    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    # Proxy all /api/* requests through Cloudflare Tunnel to Local Windows PC
    location /api/ {
        proxy_pass ${CLOUDFLARE_TUNNEL_URL}/api/;

        # Proxy headers
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # SNI handshake critical for Cloudflare HTTPS tunnels
        proxy_ssl_server_name on;
        proxy_ssl_protocols TLSv1.2 TLSv1.3;

        # WebSocket & connection upgrade support
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Resilient timeout handling
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Lightweight Gateway health check endpoint (served directly by Nginx on Render)
    location /gateway/health {
        access_log off;
        default_type application/json;
        return 200 '{"status":"online","service":"hh-loanhub-gateway","runtime":"Render Cloud Gateway","upstream":"${CLOUDFLARE_TUNNEL_URL}"}';
    }
}
